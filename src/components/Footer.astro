---
import { siteData } from '../data/company';

// Ubicaciones con coordenadas exactas (más precisas que buscar la dirección en texto)
const ubicaciones = [
  { id: 'oficina', nombre: 'Oficina', detalle: siteData.contact.address, lat: -7.168287, lng: -78.501464 },
  { id: 'almacen', nombre: 'Almacén', detalle: 'Ubicación de nuestro almacén', lat: -7.187722, lng: -78.4805 },
].map((u) => ({
  ...u,
  embed: `https://www.google.com/maps?q=${u.lat},${u.lng}&z=17&output=embed`,
  link: `https://www.google.com/maps?q=${u.lat},${u.lng}`,
}));
---

<footer class="bg-slate-100 text-slate-600 py-12 border-t-4 border-blue-500 mt-20">
  <div class="max-w-7xl mx-auto px-4 grid grid-cols-1 md:grid-cols-3 gap-12">
    <!-- Columna 1: Marca -->
    <div>
      <a href="/" class="flex items-center mb-6">
        <img src="/logo.png" alt="EG Globalnorte" class="h-24 md:h-28 w-auto mix-blend-multiply object-contain" />
      </a>
      <p class="text-sm text-slate-500 mb-6 leading-relaxed">
        {siteData.description}
      </p>

      <!-- Redes sociales: agregar aquí cuando estén disponibles -->
      <!--
      <div class="flex gap-3">
        <a href="https://facebook.com/..." target="_blank" rel="noopener noreferrer" class="w-9 h-9 rounded-full bg-slate-200 hover:bg-blue-500 hover:text-white text-slate-600 flex items-center justify-center transition-colors">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M22 12a10 10 0 10-11.5 9.87v-6.98H7.9V12h2.6V9.8c0-2.56 1.52-3.98 3.87-3.98 1.12 0 2.3.2 2.3.2v2.53h-1.3c-1.28 0-1.68.8-1.68 1.62V12h2.86l-.46 2.89h-2.4v6.98A10 10 0 0022 12z"/></svg>
        </a>
        <a href="https://instagram.com/..." target="_blank" rel="noopener noreferrer" class="w-9 h-9 rounded-full bg-slate-200 hover:bg-blue-500 hover:text-white text-slate-600 flex items-center justify-center transition-colors">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.16c3.2 0 3.58.01 4.85.07 3.25.15 4.77 1.69 4.92 4.92.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.15 3.23-1.66 4.77-4.92 4.92-1.27.06-1.64.07-4.85.07s-3.58-.01-4.85-.07c-3.26-.15-4.77-1.7-4.92-4.92-.06-1.27-.07-1.65-.07-4.85s.02-3.58.07-4.85c.15-3.23 1.67-4.77 4.92-4.92 1.27-.06 1.65-.07 4.85-.07zM12 0C8.74 0 8.33.01 7.05.07c-4.35.2-6.78 2.62-6.98 6.98C.01 8.33 0 8.74 0 12s.01 3.67.07 4.95c.2 4.36 2.62 6.78 6.98 6.98C8.33 23.99 8.74 24 12 24s3.67-.01 4.95-.07c4.35-.2 6.78-2.62 6.98-6.98.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95c-.2-4.35-2.62-6.78-6.98-6.98C15.67.01 15.26 0 12 0zm0 5.84A6.16 6.16 0 1018.16 12 6.16 6.16 0 0012 5.84zM12 16a4 4 0 110-8 4 4 0 010 8zm6.41-10.85a1.44 1.44 0 11-1.44-1.44 1.44 1.44 0 011.44 1.44z"/></svg>
        </a>
      </div>
      -->
    </div>

    <!-- Columna 2: Contacto -->
    <div>
      <h4 class="text-slate-800 font-black mb-6 uppercase text-sm tracking-wider">Contacto Directo</h4>
      <ul class="space-y-4 text-sm font-medium">
        <li class="flex items-start gap-3">
          <svg class="w-5 h-5 text-blue-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
          <span>{siteData.contact.address}</span>
        </li>
        <li class="flex items-center gap-3">
          <svg class="w-5 h-5 text-blue-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
          <a href={siteData.socials.whatsapp} target="_blank" rel="noopener noreferrer" class="hover:text-blue-500 transition-colors">{siteData.contact.displayPhone}</a>
        </li>
        <li class="flex items-center gap-3">
          <svg class="w-5 h-5 text-blue-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
          <a href={`mailto:${siteData.contact.email}`} class="hover:text-blue-500 transition-colors">{siteData.contact.email}</a>
        </li>
      </ul>
    </div>

    <!-- Columna 3: Horarios -->
    <div>
      <h4 class="text-slate-800 font-black mb-6 uppercase text-sm tracking-wider">Horario de Atención</h4>
      <ul class="space-y-3 text-sm">
        <li class="flex justify-between border-b border-slate-200 pb-2">
          <span class="text-slate-500">Días:</span>
          <span class="font-bold text-slate-700">{siteData.schedule.days}</span>
        </li>
        <li class="flex justify-between border-b border-slate-200 pb-2">
          <span class="text-slate-500">Mañanas:</span>
          <span class="font-bold text-slate-700">{siteData.schedule.morning}</span>
        </li>
        <li class="flex justify-between pb-2">
          <span class="text-slate-500">Tardes:</span>
          <span class="font-bold text-slate-700">{siteData.schedule.afternoon}</span>
        </li>
      </ul>
    </div>
  </div>

  <!-- Mapa de ubicaciones: Oficina y Almacén -->
  <div class="max-w-7xl mx-auto px-4 mt-12">
    <div class="flex justify-center gap-2 mb-4">
      {ubicaciones.map((u, i) => (
        <button type="button" data-embed={u.embed} data-link={u.link} data-detalle={u.detalle} class={`loc-tab px-5 py-2 rounded-xl text-sm font-bold transition-colors cursor-pointer ${i === 0 ? 'bg-blue-600 text-white' : 'bg-white text-slate-600 border border-slate-300'}`}>
          {u.nombre}
        </button>
      ))}
    </div>
    <div class="rounded-xl overflow-hidden border border-slate-300 shadow-sm">
      <iframe id="map-frame" src={ubicaciones[0].embed} width="100%" height="280" style="border:0;" allowfullscreen loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="Ubicación de EG Globalnorte en Cajamarca"></iframe>
    </div>
    <div class="text-center mt-3">
      <p id="map-caption" class="text-xs text-slate-500 mb-1">{ubicaciones[0].detalle}</p>
      <a id="map-link" href={ubicaciones[0].link} target="_blank" rel="noopener noreferrer" class="text-sm font-bold text-blue-600 hover:text-blue-700 transition-colors">
        Cómo llegar →
      </a>
    </div>
  </div>

  <!-- Barra legal: Libro de Reclamaciones + Política de Privacidad -->
  <div class="max-w-7xl mx-auto px-4 mt-10 pt-8 border-t border-slate-200 flex flex-wrap justify-center items-center gap-4">
    <a href="/libro-de-reclamaciones" class="inline-flex items-center gap-2 bg-orange-500 hover:bg-orange-600 text-white font-bold text-sm px-5 py-2.5 rounded-lg shadow-sm transition-colors">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>
      Libro de Reclamaciones
    </a>
    <a href="/politica-de-privacidad" class="text-sm font-bold text-slate-500 hover:text-blue-600 transition-colors">
      Política de Privacidad
    </a>
  </div>

  <div class="max-w-7xl mx-auto px-4 mt-6 text-sm text-center text-slate-400 font-medium">
    &copy; {new Date().getFullYear()} {siteData.name}. Todos los derechos reservados.
  </div>
</footer>

<script>
  const locTabs = document.querySelectorAll('.loc-tab');
  const mapFrame = document.getElementById('map-frame');
  const mapLink = document.getElementById('map-link');
  const mapCaption = document.getElementById('map-caption');

  locTabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      locTabs.forEach((t) => {
        t.classList.remove('bg-blue-600', 'text-white');
        t.classList.add('bg-white', 'text-slate-600', 'border', 'border-slate-300');
      });
      tab.classList.remove('bg-white', 'text-slate-600', 'border', 'border-slate-300');
      tab.classList.add('bg-blue-600', 'text-white');

      mapFrame.setAttribute('src', tab.getAttribute('data-embed'));
      mapLink.setAttribute('href', tab.getAttribute('data-link'));
      mapCaption.textContent = tab.getAttribute('data-detalle');
    });
  });
</script>
