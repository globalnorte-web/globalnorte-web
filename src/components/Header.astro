---
import { siteData } from '../data/company';

const phone = siteData.contact.phone || "51953867500";
---

<header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-slate-200 text-slate-800 shadow-sm">
  <div class="max-w-7xl mx-auto px-4 py-3 flex items-center justify-between gap-4">

    <!-- Logo Agrandado un 50% sobre Fondo Blanco -->
    <a href="/" class="flex items-center group">
      <img src="/logo.png" alt="Grupo Globalnorte Logo" class="h-14 md:h-20 w-auto object-contain transition-transform duration-300 group-hover:scale-105" />
    </a>

    <!-- Navegación Principal -->
    <nav class="hidden md:flex items-center gap-8 font-bold text-sm text-slate-700">
      <a href="/" class="hover:text-blue-600 transition-colors">Inicio</a>
      <a href="/#nosotros" class="hover:text-blue-600 transition-colors">Nosotros</a>
      <a href="/#servicios" class="hover:text-blue-600 transition-colors">Servicios</a>
      <a href="/#catalogo" class="hover:text-blue-600 transition-colors">Catálogo</a>
    </nav>

    <!-- Botón de Contacto -->
    <div class="flex items-center gap-3">
      <a href={`https://wa.me/${phone}?text=${encodeURIComponent('Hola Grupo Globalnorte, deseo realizar una consulta comercial.')}`} target="_blank" rel="noopener noreferrer" class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-2.5 rounded-xl font-bold text-sm transition-all shadow-md shadow-blue-500/20">
        Contáctanos
      </a>
    </div>

  </div>
</header>