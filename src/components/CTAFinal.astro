---
// src/components/CTAFinal.astro
import { siteData } from '../data/company';

const phoneDigits = siteData.contact.phone.replace(/\s/g, '');
const telHref = `tel:+51${phoneDigits}`;
---

<section class="py-20 bg-white border-t border-slate-100">
  <div class="max-w-7xl mx-auto px-4">
    <div class="grid lg:grid-cols-2 gap-10 items-center">

      <div>
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-black text-slate-900 mb-4">
          ¿Tienes un proyecto en puerta?
        </h2>
        <p class="text-slate-600 text-base md:text-lg leading-relaxed mb-8 max-w-lg">
          Escríbenos o llámanos directamente — nuestro equipo técnico te responde rápido con disponibilidad de stock y cotización formal.
        </p>
        <div class="flex flex-wrap gap-3">
          <a href={siteData.socials.whatsapp} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white font-bold px-8 py-3.5 rounded-xl text-sm transition-colors shadow-lg shadow-blue-500/20">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path></svg>
            Cotizar por WhatsApp
          </a>
          <a href={telHref} class="inline-flex items-center gap-2 border border-slate-300 text-slate-700 font-bold px-8 py-3.5 rounded-xl text-sm hover:border-blue-500 hover:text-blue-600 transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
            Llamar: {siteData.contact.displayPhone}
          </a>
        </div>
      </div>

      <div class="relative">
        <div class="absolute inset-0 bg-blue-100 rounded-2xl transform translate-x-3 translate-y-3 -z-10"></div>
        <img src="/nosotros/entrega-geomembranas.jpg" alt="Entrega de geomembranas HDPE Globalnorte en obra" class="rounded-2xl shadow-xl w-full object-cover h-[320px] md:h-[380px]" />
      </div>

    </div>
  </div>
</section>
