---
import { siteData } from '../data/company';

// Fotos del carrusel de la portada. La primera se carga de inmediato; las demás, después.
// Para agregar otra: súbela a public/nosotros/ y suma una línea aquí.
const slides = [
  { src: '/nosotros/despacho-geomembranas.jpg', alt: 'Despacho de geomembranas HDPE Grupo Global Norte' },
  { src: '/nosotros/descarga-geomembrana-hdpe-camion-grua-geotextil.jpg', alt: 'Descarga de rollos de geomembrana HDPE con camión grúa sobre geotextil en obra' },
  { src: '/nosotros/despacho-rollos-geomembrana-hdpe-camion-grua.jpg', alt: 'Camión grúa junto a rollos de geomembrana HDPE listos para su despacho' },
  { src: '/nosotros/almacen-rollos-geosinteticos-embalados.jpg', alt: 'Almacén con rollos de geosintéticos embalados' },
  { src: '/nosotros/rollos-geosinteticos-apilados-obra.jpg', alt: 'Rollos de geosintéticos apilados en obra para su instalación' },
];
---

<section class="relative bg-slate-800 text-white pt-24 pb-32 overflow-hidden border-b-8 border-blue-500">
  <!-- Fondo con superposición: carrusel de fotos -->
  <div class="absolute inset-0 z-0">
    {slides.map((s, i) => (
      <img
        src={i === 0 ? s.src : undefined}
        data-src={i === 0 ? undefined : s.src}
        alt={s.alt}
        aria-hidden={i === 0 ? 'false' : 'true'}
        fetchpriority={i === 0 ? 'high' : undefined}
        decoding="async"
        class={`hero-slide absolute inset-0 w-full h-full object-cover mix-blend-luminosity transition-opacity duration-1000 ${i === 0 ? 'opacity-20' : 'opacity-0'}`}
      />
    ))}
  </div>

  <div class="max-w-7xl mx-auto px-4 relative z-10 text-center">
    <span class="text-blue-400 font-bold tracking-widest uppercase text-sm mb-4 block">MATERIALES QUE CONSTRUYEN EL FUTURO</span>
    <h1 class="text-5xl md:text-7xl font-black mb-6 leading-tight">
      Geosintéticos y Tuberías <br/> <span class="text-blue-500">para tu Proyecto</span>
    </h1>
    <p class="text-slate-300 text-lg md:text-xl max-w-2xl mx-auto mb-10 leading-relaxed">
      Geomembranas, geotextiles, tuberías HDPE/PVC y equipos de termofusión para minería, agro, infraestructura y vías en Cajamarca y el norte del Perú.
    </p>

    <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
      <a href={siteData.socials.whatsapp} target="_blank" rel="noopener noreferrer" class="bg-blue-500 hover:bg-blue-600 text-white font-bold py-4 px-8 rounded-lg text-lg transition-all shadow-lg shadow-blue-500/30 w-full sm:w-auto">
        Cotizar por WhatsApp
      </a>
      <a href="/#catalogo" class="bg-slate-700 hover:bg-slate-600 text-white font-bold py-4 px-8 rounded-lg text-lg transition-all border border-slate-500 w-full sm:w-auto">
        Ver Catálogo
      </a>
      <a href="/#calculadora" class="flex items-center justify-center gap-2 text-slate-300 hover:text-white font-bold py-4 px-6 text-base transition-colors w-full sm:w-auto">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 7h6m0 3h-6m-2 5h10M5 21h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>
        Calculadora de Materiales
      </a>
    </div>
  </div>
</section>

<script>
  // Carrusel del fondo: cambia de foto cada 3 segundos con un fundido suave.
  const fotos = Array.from(document.querySelectorAll<HTMLImageElement>('.hero-slide'));

  if (fotos.length > 1) {
    const sinMovimiento = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let actual = 0;

    const mostrar = (n: number) => {
      fotos.forEach((img, i) => {
        const activa = i === n;
        img.classList.toggle('opacity-20', activa);
        img.classList.toggle('opacity-0', !activa);
        img.setAttribute('aria-hidden', String(!activa));
      });
      actual = n;
    };

    const iniciar = () => {
      // Si la persona pidió menos movimiento, se queda la primera foto y no se descargan las demás
      if (sinMovimiento) return;

      // Recién ahora se descargan las otras fotos, para no frenar la carga de la portada
      fotos.forEach((img) => {
        const ruta = img.dataset.src;
        if (ruta) img.src = ruta;
      });

      window.setInterval(() => {
        const siguiente = (actual + 1) % fotos.length;
        const lista = fotos[siguiente].complete && fotos[siguiente].naturalWidth > 0;
        if (lista) mostrar(siguiente); // si aún no terminó de cargar, espera al próximo turno
      }, 3000);
    };

    if (document.readyState === 'complete') iniciar();
    else window.addEventListener('load', iniciar, { once: true });
  }
</script>