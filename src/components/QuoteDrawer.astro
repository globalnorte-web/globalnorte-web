---
import { siteData } from '../data/company';

const cleanPhone = siteData.contact.phone || "51960457147";
---

<!-- Botón Flotante (Badge) -->
<div class="fixed bottom-6 right-6 z-50">
  <button 
    id="toggle-quote-drawer" 
    class="bg-blue-600 hover:bg-blue-700 text-white p-4 rounded-full shadow-2xl flex items-center gap-3 transition-all transform hover:scale-105 cursor-pointer relative"
  >
    <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path>
    </svg>
    <span class="font-bold text-sm hidden md:inline">Mi Cotización</span>
    <span id="quote-count" class="bg-amber-400 text-slate-900 font-black text-xs w-6 h-6 rounded-full flex items-center justify-center shadow-md">0</span>
  </button>
</div>

<!-- Drawer Lateral de Cotización Híbrida -->
<div id="quote-drawer-backdrop" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 hidden transition-opacity">
  <div class="fixed right-0 top-0 h-full w-full max-w-lg bg-white shadow-2xl flex flex-col justify-between overflow-hidden">
    
    <!-- Header -->
    <div class="p-5 bg-slate-900 text-white flex justify-between items-center border-b border-slate-800">
      <div>
        <h3 class="font-black text-lg text-blue-400">Panel de Cotización B2B</h3>
        <p class="text-xs text-slate-400">Grupo Globalnorte - Soluciones para Obras</p>
      </div>
      <button id="close-quote-drawer" class="text-slate-400 hover:text-white p-2 text-2xl font-bold cursor-pointer">&times;</button>
    </div>

    <!-- Cuerpo del Drawer: Lista + Datos Corporativos -->
    <div class="p-6 overflow-y-auto flex-grow space-y-6">

      <!-- ========================= -->
      <!-- VISTA 1: CARRITO + DATOS  -->
      <!-- ========================= -->
      <div id="quote-main-view" class="space-y-6">

        <!-- Listado de Productos Seleccionados -->
        <div>
          <div class="flex items-center justify-between mb-3">
            <h4 class="text-xs font-bold text-slate-400 uppercase tracking-wider">1. Materiales Seleccionados</h4>
            <span class="text-[11px] text-blue-600 font-bold">Modifica cantidades si lo requieres</span>
          </div>
          <div id="quote-items-container" class="space-y-3">
            <!-- Inyectado dinámicamente -->
          </div>
        </div>

        <!-- Acordeón / Formulario Opcional para Empresas -->
        <div class="bg-slate-50 border border-slate-200 rounded-2xl p-4">
          <button id="toggle-corporate-fields" type="button" class="w-full flex items-center justify-between text-left text-slate-800 font-bold text-sm cursor-pointer">
            <span class="flex items-center gap-2">
              <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
              2. Datos de Proyecto / RUC (Opcional)
            </span>
            <span id="corporate-icon" class="text-slate-400 text-lg font-bold">+</span>
          </button>

          <div id="corporate-fields" class="hidden mt-4 space-y-3 border-t border-slate-200 pt-4">
            <div class="grid grid-cols-2 gap-3">
              <div>
                <label class="block text-[11px] font-bold text-slate-500 uppercase mb-1">Tipo Doc.</label>
                <select id="field-doc-type" class="w-full bg-white border border-slate-300 rounded-lg p-2 text-xs font-bold text-slate-700">
                  <option value="RUC">RUC (Empresa)</option>
                  <option value="DNI">DNI (Persona)</option>
                </select>
              </div>
              <div>
                <label class="block text-[11px] font-bold text-slate-500 uppercase mb-1">N° RUC / DNI</label>
                <input type="text" id="field-doc-number" placeholder="20XXXXXXXXX" class="w-full bg-white border border-slate-300 rounded-lg p-2 text-xs font-bold text-slate-700" />
              </div>
            </div>

            <div>
              <label class="block text-[11px] font-bold text-slate-500 uppercase mb-1">Razón Social / Nombre</label>
              <input type="text" id="field-company-name" placeholder="Ej. Constructora del Norte S.A.C." class="w-full bg-white border border-slate-300 rounded-lg p-2 text-xs font-bold text-slate-700" />
            </div>

            <div>
              <label class="block text-[11px] font-bold text-slate-500 uppercase mb-1">Ciudad / Destino de la Obra</label>
              <input type="text" id="field-city" placeholder="Ej. Cajamarca, Trujillo, Piura..." class="w-full bg-white border border-slate-300 rounded-lg p-2 text-xs font-bold text-slate-700" />
            </div>

            <div>
              <label class="block text-[11px] font-bold text-slate-500 uppercase mb-1">Adjuntar Plano o Expediente (PDF / Foto)</label>
              <input type="file" id="field-file-upload" accept=".pdf,image/*" class="w-full text-xs text-slate-500 file:mr-3 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-bold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100 cursor-pointer" />
              <p id="file-name-display" class="text-[10px] text-emerald-600 font-bold mt-1 hidden"></p>
            </div>
          </div>
        </div>

      </div>

      <!-- ========================= -->
      <!-- VISTA 2: CONFIRMACIÓN     -->
      <!-- ========================= -->
      <div id="quote-success-view" class="hidden space-y-5">

        <div class="flex items-center gap-3">
          <div class="w-11 h-11 bg-emerald-100 text-emerald-600 rounded-full flex items-center justify-center flex-shrink-0">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
          </div>
          <div>
            <h4 class="font-black text-slate-900 text-sm">Tu cotización está lista</h4>
            <p class="text-xs text-slate-500">Revisa el resumen antes de enviarla</p>
          </div>
        </div>

        <!-- Aviso de archivo adjunto: solo se muestra si el cliente subió uno -->
        <div id="file-reminder-box" class="hidden bg-amber-50 border-2 border-amber-300 rounded-xl p-4">
          <p class="font-black text-amber-800 text-sm flex items-center gap-2">
            <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13"></path></svg>
            ¡No olvides tu archivo!
          </p>
          <p class="text-xs text-amber-700 mt-1 leading-relaxed">
            Seleccionaste <strong id="file-reminder-name" class="font-bold"></strong>. WhatsApp no permite que las páginas web adjunten archivos automáticamente, así que al abrir el chat deberás <strong>tocar el clip 📎 y adjuntarlo tú mismo</strong> — está recién seleccionado, así que aparecerá primero en tus archivos recientes.
          </p>
        </div>

        <div class="bg-slate-50 border border-slate-200 rounded-xl p-4">
          <p class="text-xs font-bold text-slate-500 uppercase mb-2">Resumen a enviar</p>
          <pre id="quote-summary-preview" class="whitespace-pre-wrap text-xs text-slate-700 font-sans leading-relaxed"></pre>
        </div>

        <button id="back-to-cart" type="button" class="text-xs font-bold text-slate-500 hover:text-slate-700 flex items-center gap-1 cursor-pointer">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
          Volver y editar mi cotización
        </button>

      </div>

    </div>

    <!-- Footer con Acción Inmediata -->
    <div class="p-5 border-t border-slate-200 bg-slate-50 space-y-3">
      <button id="review-quote-btn" type="button" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-3.5 px-4 rounded-xl flex items-center justify-center gap-2 transition-all shadow-lg shadow-blue-500/30 cursor-pointer text-sm uppercase tracking-wider">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path></svg>
        Revisar y Enviar Cotización
      </button>
      <button id="open-whatsapp-btn" type="button" class="hidden w-full bg-emerald-500 hover:bg-emerald-600 text-white font-bold py-3.5 px-4 rounded-xl flex items-center justify-center gap-2 transition-all shadow-lg shadow-emerald-500/30 cursor-pointer text-sm uppercase tracking-wider">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path></svg>
        Abrir WhatsApp y Enviar
      </button>
      <p class="text-[11px] text-center text-slate-400">Respuesta inmediata de nuestro equipo técnico comercial.</p>
    </div>

  </div>
</div>

<script id="quote-script" data-phone={cleanPhone}>
  let cart = [];
  let attachedFileName = "";

  const toggleBtn = document.getElementById('toggle-quote-drawer');
  const closeBtn = document.getElementById('close-quote-drawer');
  const backdrop = document.getElementById('quote-drawer-backdrop');
  const container = document.getElementById('quote-items-container');
  const countBadge = document.getElementById('quote-count');
  const scriptEl = document.getElementById('quote-script');

  const toggleCorporateBtn = document.getElementById('toggle-corporate-fields');
  const corporateFields = document.getElementById('corporate-fields');
  const corporateIcon = document.getElementById('corporate-icon');
  const fileInput = document.getElementById('field-file-upload');
  const fileNameDisplay = document.getElementById('file-name-display');

  const mainView = document.getElementById('quote-main-view');
  const successView = document.getElementById('quote-success-view');
  const reviewBtn = document.getElementById('review-quote-btn');
  const openWhatsappBtn = document.getElementById('open-whatsapp-btn');
  const backToCartBtn = document.getElementById('back-to-cart');
  const fileReminderBox = document.getElementById('file-reminder-box');
  const fileReminderName = document.getElementById('file-reminder-name');
  const summaryPreview = document.getElementById('quote-summary-preview');

  let pendingWhatsappUrl = '';

  const cleanPhone = scriptEl ? scriptEl.getAttribute('data-phone') : "51960457147";

  // --- Persistencia del carrito entre páginas (localStorage) ---
  const CART_STORAGE_KEY = 'globalnorte_quote_cart';

  function saveCart() {
    try {
      localStorage.setItem(CART_STORAGE_KEY, JSON.stringify(cart));
    } catch (err) {
      console.error('No se pudo guardar el carrito', err);
    }
  }

  try {
    const stored = localStorage.getItem(CART_STORAGE_KEY);
    if (stored) cart = JSON.parse(stored);
  } catch (err) {
    cart = [];
  }

  // Toggle de la sección opcional de datos corporativos
  if (toggleCorporateBtn && corporateFields && corporateIcon) {
    toggleCorporateBtn.addEventListener('click', () => {
      const isHidden = corporateFields.classList.contains('hidden');
      if (isHidden) {
        corporateFields.classList.remove('hidden');
        corporateIcon.innerText = '−';
      } else {
        corporateFields.classList.add('hidden');
        corporateIcon.innerText = '+';
      }
    });
  }

  // Manejo de archivo adjunto
  if (fileInput && fileNameDisplay) {
    fileInput.addEventListener('change', (e) => {
      const target = e.target;
      if (target.files && target.files[0]) {
        attachedFileName = target.files[0].name;
        fileNameDisplay.innerText = `✓ Archivo listo: ${attachedFileName} (Se enviará al abrir el chat)`;
        fileNameDisplay.classList.remove('hidden');
      } else {
        attachedFileName = "";
        fileNameDisplay.classList.add('hidden');
      }
    });
  }

  function renderCart() {
    if (countBadge) {
      countBadge.innerText = cart.reduce((acc, item) => acc + item.quantity, 0).toString();
    }

    if (!container) return;

    if (cart.length === 0) {
      container.innerHTML = `
        <div class="text-center py-8 text-slate-400 bg-slate-50 rounded-xl border border-dashed border-slate-200">
          <svg class="w-10 h-10 mx-auto mb-2 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"></path></svg>
          <p class="font-bold text-xs text-slate-600">Tu lista está vacía</p>
          <p class="text-[11px]">Añade productos desde el catálogo para cotizar.</p>
        </div>
      `;
      return;
    }

    container.innerHTML = cart.map((item, index) => `
      <div class="bg-slate-50 p-3 rounded-xl flex items-center justify-between gap-3 border border-slate-200">
        <div class="flex-grow">
          <h4 class="font-bold text-slate-800 text-xs">${item.name}</h4>
          <span class="text-[9px] bg-blue-100 text-blue-700 font-bold px-1.5 py-0.5 rounded">${item.category}</span>
          <span class="text-[9px] bg-slate-200 text-slate-600 font-bold px-1.5 py-0.5 rounded ml-1">${item.unit || 'unidad'}</span>
          ${item.customInfo ? `<p class="text-[11px] text-amber-600 font-medium mt-0.5">${item.customInfo}</p>` : ''}
        </div>

        <div class="flex items-center gap-2">
          <input 
            type="number" 
            min="1" 
            value="${item.quantity}" 
            data-index="${index}" 
            class="item-qty w-12 bg-white border border-slate-300 rounded p-1 text-center font-bold text-xs" 
          />
          <button data-index="${index}" class="remove-item text-red-500 hover:text-red-700 font-bold p-1 text-base cursor-pointer">&times;</button>
        </div>
      </div>
    `).join('');

    document.querySelectorAll('.item-qty').forEach(input => {
      input.addEventListener('change', (e) => {
        const target = e.target;
        const idx = parseInt(target.getAttribute('data-index') || '0', 10);
        if (cart[idx]) {
          cart[idx].quantity = Math.max(1, parseInt(target.value, 10) || 1);
        }
        saveCart();
        renderCart();
      });
    });

    document.querySelectorAll('.remove-item').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget;
        const idx = parseInt(target.getAttribute('data-index') || '0', 10);
        cart.splice(idx, 1);
        saveCart();
        renderCart();
      });
    });
  }

  // Pinta el carrito guardado apenas carga cualquier página del sitio
  renderCart();

  // Escuchar evento de añadir productos
  window.addEventListener('add-to-quote', (e) => {
    const detail = e.detail;
    if (!detail) return;

    const existing = cart.find(i => i.id === detail.id);

    const addQty = detail.quantity && detail.quantity > 0 ? detail.quantity : 1;

    if (existing) {
      existing.quantity += addQty;
    } else {
      cart.push({
        id: detail.id,
        name: detail.name,
        category: detail.category,
        unit: detail.unit || 'unidad',
        quantity: addQty,
        customInfo: detail.customInfo
      });
    }

    saveCart();
    renderCart();

    // Animación de feedback para el usuario (reemplaza la apertura forzada)
    if (toggleBtn) {
      toggleBtn.classList.remove('bg-blue-600', 'hover:bg-blue-700');
      toggleBtn.classList.add('bg-emerald-500', 'scale-110');
      
      setTimeout(() => {
        toggleBtn.classList.add('bg-blue-600', 'hover:bg-blue-700');
        toggleBtn.classList.remove('bg-emerald-500', 'scale-110');
      }, 400); // Vuelve a la normalidad después de 400ms
    }
  });

  if (toggleBtn) toggleBtn.addEventListener('click', () => backdrop && backdrop.classList.toggle('hidden'));
  if (closeBtn) closeBtn.addEventListener('click', () => backdrop && backdrop.classList.add('hidden'));

  // Paso 1: arma el resumen y muestra la vista de confirmación (no abre WhatsApp todavía)
  if (reviewBtn) {
    reviewBtn.addEventListener('click', () => {
      if (cart.length === 0) return alert('Añade al menos un producto a tu lista.');

      const docType = document.getElementById('field-doc-type')?.value || 'RUC';
      const docNum = document.getElementById('field-doc-number')?.value.trim();
      const companyName = document.getElementById('field-company-name')?.value.trim();
      const city = document.getElementById('field-city')?.value.trim();

      let text = `*SOLICITUD DE COTIZACIÓN TÉCNICA*\n*Grupo Globalnorte B2B*\n------------------------------\n`;

      if (companyName || docNum || city) {
        text += `*DATOS DEL CLIENTE / PROYECTO:*\n`;
        if (companyName) text += `• Empresa/Cliente: ${companyName}\n`;
        if (docNum) text += `• ${docType}: ${docNum}\n`;
        if (city) text += `• Ciudad/Obra: ${city}\n`;
        text += `------------------------------\n`;
      }

      text += `*DETALLE DE MATERIALES:*\n`;
      cart.forEach((item, i) => {
        text += `${i + 1}. *${item.name}* (${item.category})\n   Cantidad: ${item.quantity} ${item.unit || 'unidad'}\n`;
        if (item.customInfo) text += `   Especificación: ${item.customInfo}\n`;
      });

      if (attachedFileName) {
        text += `------------------------------\n📎 *Recordatorio:* adjuntar manualmente el archivo "${attachedFileName}" en este chat.`;
      }

      text += `\n------------------------------\nSolicito disponibilidad inmediata de stock y cotización formal.`;

      pendingWhatsappUrl = `https://wa.me/${cleanPhone}?text=${encodeURIComponent(text)}`;

      // Muestra el recordatorio grande del archivo solo si el cliente adjuntó uno
      if (attachedFileName && fileReminderBox && fileReminderName) {
        fileReminderName.textContent = attachedFileName;
        fileReminderBox.classList.remove('hidden');
      } else if (fileReminderBox) {
        fileReminderBox.classList.add('hidden');
      }

      if (summaryPreview) summaryPreview.textContent = text.replace(/\*/g, '');

      // Cambia de vista: oculta el carrito, muestra la confirmación
      if (mainView) mainView.classList.add('hidden');
      if (successView) successView.classList.remove('hidden');
      if (reviewBtn) reviewBtn.classList.add('hidden');
      if (openWhatsappBtn) openWhatsappBtn.classList.remove('hidden');
    });
  }

  // Paso 2: recién aquí se abre WhatsApp de verdad, y luego se vacía el carrito
  if (openWhatsappBtn) {
    openWhatsappBtn.addEventListener('click', () => {
      if (pendingWhatsappUrl) window.open(pendingWhatsappUrl, '_blank');

      // La cotización ya se envió: vaciamos el carrito y volvemos a la vista principal
      cart = [];
      attachedFileName = "";
      saveCart();
      renderCart();

      if (fileInput) fileInput.value = '';
      if (fileNameDisplay) { fileNameDisplay.classList.add('hidden'); fileNameDisplay.innerText = ''; }

      if (mainView) mainView.classList.remove('hidden');
      if (successView) successView.classList.add('hidden');
      if (reviewBtn) reviewBtn.classList.remove('hidden');
      if (openWhatsappBtn) openWhatsappBtn.classList.add('hidden');
    });
  }

  // Volver del resumen al carrito para seguir editando
  if (backToCartBtn) {
    backToCartBtn.addEventListener('click', () => {
      if (mainView) mainView.classList.remove('hidden');
      if (successView) successView.classList.add('hidden');
      if (reviewBtn) reviewBtn.classList.remove('hidden');
      if (openWhatsappBtn) openWhatsappBtn.classList.add('hidden');
    });
  }
</script>