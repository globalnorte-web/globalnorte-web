---
import { catalog } from '../data/products';
import { siteData } from '../data/company';

const cleanPhone = siteData.contact.phone || "51960457147"; 
const categories = ["Todos", ...Array.from(new Set(catalog.map(p => p.category)))];

// Extraer proyectos únicos para el filtro guiado
const projectTypes = ["Todos los Proyectos", "Minería", "Carreteras y Vías", "Agro y Reservorios", "Edificación e Infraestructura"];
---

<section id="catalogo" class="py-24 bg-white border-t border-slate-100">
  <div class="max-w-7xl mx-auto px-4">
    <div class="text-center mb-12">
      <h2 class="text-4xl font-black text-slate-800 mb-4">Soluciones para Obras e Industria</h2>
      <p class="text-slate-500 text-lg max-w-2xl mx-auto">Filtra por tu tipo de proyecto o categoría de material. Arma tu cotización múltiple en tiempo real.</p>
    </div>

    <!-- Filtro Guiado por Tipo de Obra -->
    <div class="mb-8 bg-slate-50 p-4 rounded-2xl border border-slate-200">
      <span class="text-xs font-bold text-slate-400 uppercase tracking-wider block mb-3 text-center md:text-left">
        Filtro Guiado por Aplicación de Proyecto:
      </span>
      <div class="flex flex-wrap gap-2 justify-center md:justify-start" id="project-filters">
        {projectTypes.map((proj, idx) => (
          <button 
            data-project={proj}
            class={`project-btn px-4 py-2 rounded-xl text-xs font-bold transition-all cursor-pointer ${
              idx === 0 
                ? 'bg-slate-800 text-white' 
                : 'bg-white text-slate-600 border border-slate-200 hover:border-slate-400'
            }`}
          >
            {proj}
          </button>
        ))}
      </div>
    </div>

    <!-- Buscador e Indicador de Categorías -->
    <div class="mb-12 space-y-6">
      <div class="max-w-xl mx-auto relative">
        <input 
          type="text" 
          id="catalog-search" 
          placeholder="Buscar por nombre o especificación (ej. Geomembrana, LAC, HDPE)..." 
          class="w-full pl-12 pr-4 py-3.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white transition-all shadow-sm font-medium"
        />
        <svg class="w-6 h-6 text-slate-400 absolute left-4 top-1/2 -translate-y-1/2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
      </div>

      <div class="flex flex-wrap justify-center gap-2 md:gap-3" id="category-filters">
        {categories.map((cat, index) => (
          <button 
            data-category={cat}
            class={`filter-btn px-5 py-2 rounded-full text-xs font-bold transition-all duration-200 cursor-pointer ${
              index === 0 
                ? 'bg-blue-500 text-white shadow-md shadow-blue-500/20' 
                : 'bg-slate-100 text-slate-600 hover:bg-slate-200'
            }`}
          >
            {cat}
          </button>
        ))}
      </div>
    </div>

    <!-- Cuadrícula de Productos -->
    <div id="product-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {catalog.map((product) => {
        const searchText = `${product.name} ${product.category} ${product.description} ${(product.features || []).join(' ')} ${(product.projects || []).join(' ')}`.toLowerCase();

        return (
          <div 
            class="product-card bg-slate-50 rounded-2xl border border-slate-200 overflow-hidden hover:shadow-xl hover:shadow-blue-500/10 transition-all duration-300 flex flex-col group"
            data-category={product.category}
            data-projects={(product.projects || []).join(',')}
            data-search={searchText}
          >
            <!-- Imagen Clicable hacia la Ficha Técnica -->
            <a href={`/producto/${product.id}`} class="h-80 overflow-hidden relative bg-slate-200 block cursor-pointer">
              <span class="absolute top-4 left-4 bg-blue-500 text-white text-xs font-bold px-3 py-1 rounded-full z-10 shadow-sm">{product.category}</span>
              <img src={product.image} alt={product.name} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
            </a>
            
            <div class="p-6 flex flex-col flex-grow">
              <a href={`/producto/${product.id}`} class="hover:text-blue-600 transition-colors">
                <h3 class="text-xl font-bold text-slate-800 mb-2">{product.name}</h3>
              </a>
              <p class="text-slate-500 text-sm mb-4 line-clamp-2">{product.description}</p>

              {product.certification && (
                <a href={product.certification.ficha} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 bg-emerald-50 text-emerald-700 border border-emerald-200 text-xs font-bold px-3 py-1.5 rounded-lg mb-4 hover:bg-emerald-100 transition-colors w-fit">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                  Ficha técnica {product.certification.codigo}
                </a>
              )}

              <ul class="mb-6 space-y-1">
                {(product.features || []).map((feature: unknown) => (
                  <li class="text-xs text-slate-600 flex items-center gap-2 font-medium">
                    <span class="w-1.5 h-1.5 rounded-full bg-blue-400"></span>
                    {String(feature)}
                  </li>
                ))}
              </ul>
              
              <div class="mt-auto flex flex-col gap-2">
                <!-- Botón Añadir al Carrito Flotante -->
                <button 
                  data-id={product.id}
                  data-name={product.name}
                  data-category={product.category}
                  data-unit={product.unit || 'unidad'}
                  class="btn-add-quote w-full flex items-center justify-center gap-2 bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-4 rounded-lg transition-colors shadow-md cursor-pointer"
                >
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path></svg>
                  Añadir a Cotización ({product.unit || 'unidad'})
                </button>

                <a href={`https://wa.me/${cleanPhone}?text=${encodeURIComponent(`Hola, quisiera hablar con un asesor sobre: ${product.name}`)}`} target="_blank" rel="noopener noreferrer" class="w-full flex items-center justify-center gap-2 border border-emerald-500 text-emerald-600 hover:bg-emerald-50 font-bold py-2 px-4 rounded-lg transition-colors text-xs">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path></svg>
                  Hablar con un Asesor
                </a>
              </div>
            </div>
          </div>
        );
      })}
    </div>

    <!-- Sin Resultados -->
    <div id="no-results" class="hidden text-center py-16 bg-slate-50 rounded-2xl border border-dashed border-slate-300 mt-8">
      <h3 class="text-xl font-bold text-slate-700 mb-1">No encontramos materiales para esa combinación</h3>
      <p class="text-slate-500 text-sm">Prueba seleccionando "Todos los Proyectos" o borrando el término de búsqueda.</p>
    </div>
  </div>
</section>

<script>
  const searchInput = document.getElementById('catalog-search') as HTMLInputElement;
  const filterBtns = document.querySelectorAll('.filter-btn');
  const projectBtns = document.querySelectorAll('.project-btn');
  const productCards = document.querySelectorAll('.product-card') as NodeListOf<HTMLElement>;
  const noResults = document.getElementById('no-results');

  let activeCategory = 'Todos';
  let activeProject = 'Todos los Proyectos';
  let searchQuery = '';

  function filterCatalog() {
    let visibleCount = 0;

    productCards.forEach((card) => {
      const category = card.getAttribute('data-category');
      const projects = (card.getAttribute('data-projects') || '').split(',');
      const searchText = card.getAttribute('data-search') || '';

      const matchesCategory = activeCategory === 'Todos' || category === activeCategory;
      const matchesProject = activeProject === 'Todos los Proyectos' || projects.includes(activeProject);
      const matchesSearch = searchText.includes(searchQuery.toLowerCase().trim());

      if (matchesCategory && matchesProject && matchesSearch) {
        card.classList.remove('hidden');
        visibleCount++;
      } else {
        card.classList.add('hidden');
      }
    });

    if (visibleCount === 0 && noResults) {
      noResults.classList.remove('hidden');
    } else if (noResults) {
      noResults.classList.add('hidden');
    }
  }

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => {
        b.classList.remove('bg-blue-500', 'text-white', 'shadow-md');
        b.classList.add('bg-slate-100', 'text-slate-600');
      });
      btn.classList.remove('bg-slate-100', 'text-slate-600');
      btn.classList.add('bg-blue-500', 'text-white', 'shadow-md');

      activeCategory = btn.getAttribute('data-category') || 'Todos';
      filterCatalog();
    });
  });

  projectBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      projectBtns.forEach(b => {
        b.classList.remove('bg-slate-800', 'text-white');
        b.classList.add('bg-white', 'text-slate-600');
      });
      btn.classList.remove('bg-white', 'text-slate-600');
      btn.classList.add('bg-slate-800', 'text-white');

      activeProject = btn.getAttribute('data-project') || 'Todos los Proyectos';
      filterCatalog();
    });
  });

  searchInput?.addEventListener('input', (e) => {
    searchQuery = (e.target as HTMLInputElement).value;
    filterCatalog();
  });

  // Evento para añadir al carrito
  document.querySelectorAll('.btn-add-quote').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const target = e.currentTarget as HTMLElement;
      const event = new CustomEvent('add-to-quote', {
        detail: {
          id: target.getAttribute('data-id'),
          name: target.getAttribute('data-name'),
          category: target.getAttribute('data-category'),
          unit: target.getAttribute('data-unit') || 'unidad'
        }
      });
      window.dispatchEvent(event);
    });
  });
</script>