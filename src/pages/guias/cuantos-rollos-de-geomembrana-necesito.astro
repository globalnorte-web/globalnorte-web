---
// src/pages/guias/cuantos-rollos-de-geomembrana-necesito.astro
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.astro';
import { siteData } from '../../data/company';

const ANCHO_ROLLO_M = 7;
const MARGEN = 1.10;

const rollosGeomembrana = [
  { espesor: '0.75 mm', largo: 400 },
  { espesor: '0.80 mm', largo: 350 },
  { espesor: '1.00 mm', largo: 310 },
  { espesor: '1.50 mm', largo: 210 },
  { espesor: '2.00 mm', largo: 115 },
  { espesor: '2.50 mm', largo: 120 },
  { espesor: '3.00 mm', largo: 100 },
];

function calcular(largo: number, ancho: number, largoRollo: number) {
  const area = largo * ancho;
  const conMargen = area * MARGEN;
  const areaRollo = ANCHO_ROLLO_M * largoRollo;
  return { area, conMargen, areaRollo, rollos: Math.ceil(conMargen / areaRollo) };
}

const ejemplos = [
  { titulo: 'Ejemplo 1: reservorio pequeño', largo: 50, ancho: 20, espesor: '1.50 mm', largoRollo: 210 },
  { titulo: 'Ejemplo 2: área grande', largo: 100, ancho: 50, espesor: '1.00 mm', largoRollo: 310 },
].map((e) => ({ ...e, ...calcular(e.largo, e.ancho, e.largoRollo) }));

const fmt = (n: number) => Math.round(n).toLocaleString('es-PE');
---

<Layout
  title="¿Cuántos rollos de geomembrana necesito? Guía de cálculo | Grupo Global Norte"
  description="Aprende a calcular cuántos rollos de geomembrana HDPE necesitas: medidas estándar de rollo por espesor, fórmula con margen de traslape y ejemplos."
>
  <article class="py-16 md:py-20 bg-white">
    <div class="max-w-3xl mx-auto px-4">
      <a href="/guias" class="text-blue-500 font-bold hover:underline text-sm">&larr; Todas las guías</a>

      <h1 class="text-3xl md:text-4xl font-black text-slate-900 mt-6 mb-4">¿Cuántos rollos de geomembrana necesito?</h1>
      <p class="text-lg text-slate-600 leading-relaxed mb-10">
        Para cotizar una geomembrana HDPE necesitas saber cuántos metros cuadrados cubrir y cuántos rollos eso representa. Esta guía te explica cómo estimarlo con las medidas estándar de rollo.
      </p>

      <div class="space-y-10 text-slate-600 leading-relaxed">

        <section>
          <h2 class="text-2xl font-black text-slate-900 mb-3">1. Mide el área real a cubrir</h2>
          <p>
            Multiplica largo por ancho del área. En un reservorio o poza, mide el área <strong>real</strong> a cubrir: además del fondo, suma los taludes (las paredes inclinadas) y la zanja de anclaje del borde. Si solo usas el área en planta, vas a quedarte corto. Si tienes dudas, pide el metrado al proyectista o consulta con nuestro asesor.
          </p>
        </section>

        <section>
          <h2 class="text-2xl font-black text-slate-900 mb-3">2. Conoce las medidas estándar de rollo</h2>
          <p class="mb-4">
            El largo del rollo depende del espesor. Según la ficha técnica, el ancho es de 7 a 8 m; la tabla usa 7 m para estar del lado seguro. También hay otros largos de rollo, consúltalo con tu asesor.
          </p>
          <div class="overflow-x-auto rounded-xl border border-slate-200">
            <table class="w-full text-sm text-left">
              <thead class="bg-slate-800 text-white">
                <tr>
                  <th class="px-4 py-3 font-bold">Espesor</th>
                  <th class="px-4 py-3 font-bold">Largo del rollo (m)</th>
                  <th class="px-4 py-3 font-bold">Área por rollo (m²)</th>
                </tr>
              </thead>
              <tbody>
                {rollosGeomembrana.map((r, i) => (
                  <tr class={i % 2 === 0 ? 'bg-white' : 'bg-slate-50'}>
                    <td class="px-4 py-3 font-bold text-slate-800">{r.espesor}</td>
                    <td class="px-4 py-3">{r.largo}</td>
                    <td class="px-4 py-3">{fmt(r.largo * ANCHO_ROLLO_M)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>

        <section>
          <h2 class="text-2xl font-black text-slate-900 mb-3">3. Aplica la fórmula</h2>
          <ol class="list-decimal pl-6 space-y-2">
            <li>Área a cubrir = largo × ancho.</li>
            <li>Suma un margen de 10 % por traslape entre paños y soldadura: área con margen = área × 1.10.</li>
            <li>Divide entre el área de un rollo del espesor elegido.</li>
            <li>Redondea siempre hacia arriba: no se venden fracciones de rollo.</li>
          </ol>
          <p class="mt-3 text-sm text-slate-500">El 10 % es una estimación referencial. El margen real depende de cómo se distribuyan los paños en tu obra.</p>
        </section>

        <section>
          <h2 class="text-2xl font-black text-slate-900 mb-4">4. Dos ejemplos</h2>
          <div class="grid sm:grid-cols-2 gap-4">
            {ejemplos.map((e) => (
              <div class="bg-slate-50 border border-slate-200 rounded-xl p-5">
                <h3 class="font-black text-slate-900 mb-3">{e.titulo}</h3>
                <ul class="text-sm space-y-1">
                  <li>Área: {e.largo} m × {e.ancho} m = <strong>{fmt(e.area)} m²</strong></li>
                  <li>Con margen de 10 %: <strong>{fmt(e.conMargen)} m²</strong></li>
                  <li>Espesor {e.espesor}: rollo de {e.largoRollo} m × 7 m = <strong>{fmt(e.areaRollo)} m²</strong></li>
                  <li>Rollos necesarios: <strong class="text-blue-600">{e.rollos}</strong></li>
                </ul>
              </div>
            ))}
          </div>
        </section>

        <section>
          <h2 class="text-2xl font-black text-slate-900 mb-3">5. Qué más considerar</h2>
          <ul class="list-disc pl-6 space-y-2">
            <li>La geomembrana se une en obra con equipos de termofusión: una <a href="/producto/equipo-cuna" class="text-blue-600 font-bold hover:underline">máquina de cuña caliente</a> para las costuras largas y una <a href="/producto/equipo-extrusora" class="text-blue-600 font-bold hover:underline">soldadora extrusora</a> para remates y reparaciones.</li>
            <li>Se suele proteger con un <a href="/producto/geotextil-no-tejido" class="text-blue-600 font-bold hover:underline">geotextil no tejido</a> debajo o encima de la membrana.</li>
            <li>Elige el producto según la exigencia del proyecto: <a href="/producto/geomembrana-hdpe-lisa-gm13" class="text-blue-600 font-bold hover:underline">Geomembrana HDPE Lisa GM13</a> (norma GRI-GM13) o <a href="/producto/geomembrana-hdpe-lisa-nominal" class="text-blue-600 font-bold hover:underline">Geomembrana HDPE Lisa Nominal</a>.</li>
          </ul>
        </section>

        <section class="bg-blue-50 border border-blue-200 rounded-2xl p-6">
          <h2 class="text-xl font-black text-slate-900 mb-2">Calcula tu caso en segundos</h2>
          <p class="mb-4 text-sm">Ingresa el largo, el ancho y el espesor en nuestra calculadora y agrega el resultado a tu cotización.</p>
          <div class="flex flex-col sm:flex-row gap-3">
            <a href="/#calculadora" class="text-center bg-blue-600 hover:bg-blue-700 text-white font-bold px-6 py-3 rounded-xl text-sm transition-colors">Ir a la calculadora</a>
            <a href={siteData.socials.whatsapp} target="_blank" rel="noopener noreferrer" class="text-center bg-slate-800 hover:bg-slate-900 text-white font-bold px-6 py-3 rounded-xl text-sm transition-colors">Hablar con un asesor</a>
          </div>
        </section>

        <p class="text-xs text-slate-400">Guía orientativa. El metrado y el espesor definitivos deben ser validados por el proyectista o responsable técnico de la obra.</p>
      </div>
    </div>
  </article>

  <Footer />
</Layout>
