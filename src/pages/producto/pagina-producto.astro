---
import Layout from '../../layouts/Layout.astro';
import { catalog } from '../../data/products';
import { siteData } from '../../data/company';

export function getStaticPaths() {
  return catalog.map(product => ({
    params: { id: product.id },
    props: { product },
  }));
}

const { product } = Astro.props;
const cleanPhone = siteData.contact.phone || "51960457147";
const whatsappMessage = encodeURIComponent(`Hola Grupo Globalnorte, deseo más información sobre:\n\n*${product.name}*`);
const whatsappUrl = `https://wa.me/${cleanPhone}?text=${whatsappMessage}`;

const relatedProducts = catalog
  .filter(p => p.category === product.category && p.id !== product.id)
  .slice(0, 3);
---

<Layout title={`${product.name} | Grupo Globalnorte`} description={product.description}>
  <div class="bg-slate-50 py-12 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4">
      <a href="/#catalogo" class="text-blue-500 font-bold hover:underline mb-8 inline-flex items-center gap-2">
        &larr; Volver al catálogo
      </a>
      
      <!-- Detalle Principal -->
      <div class="bg-white rounded-2xl shadow-xl shadow-slate-200/50 overflow-hidden grid md:grid-cols-2 gap-8 mb-16">
        <div class="h-96 md:h-auto relative">
          <img src={product.image} alt={product.name} class="w-full h-full object-cover" />
          <span class="absolute top-4 left-4 bg-blue-500 text-white text-sm font-bold px-4 py-1.5 rounded-full shadow-sm">{product.category}</span>
        </div>
        
        <div class="p-8 lg:p-12 flex flex-col justify-center">
          <h1 class="text-4xl font-black text-slate-800 mb-3">{product.name}</h1>

          {product.certification && (
            <a href={product.certification.ficha} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 bg-emerald-50 text-emerald-700 border border-emerald-200 text-sm font-bold px-4 py-2 rounded-lg mb-5 hover:bg-emerald-100 transition-colors w-fit">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
              Ficha técnica {product.certification.codigo} (PDF)
            </a>
          )}

          <p class="text-lg text-slate-600 mb-8 leading-relaxed">{product.description}</p>
          
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-8 mb-8">
            <div>
              <h3 class="font-bold text-slate-800 mb-3 border-b pb-2">Especificaciones</h3>
              <ul class="space-y-2">
                {product.features.map((feature: unknown) => (
                  <li class="text-sm text-slate-600 flex items-center gap-2">
                    <span class="w-2 h-2 rounded-full bg-blue-500"></span>{String(feature)}
                  </li>
                ))}
              </ul>
            </div>
            
            {product.uses && (
              <div>
                <h3 class="font-bold text-slate-800 mb-3 border-b pb-2">Aplicaciones y Usos</h3>
                <ul class="space-y-2">
                  {product.uses.map((uso: unknown) => (
                    <li class="text-sm text-slate-600 flex items-center gap-2">
                      <svg class="w-4 h-4 text-amber-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                      {String(uso)}
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
          
          <a href={whatsappUrl} target="_blank" class="w-full md:w-auto text-center bg-slate-800 hover:bg-blue-600 text-white font-bold py-4 px-8 rounded-lg transition-colors text-lg shadow-lg">
            Solicitar Cotización por WhatsApp
          </a>
        </div>
      </div>

      <!-- Productos Relacionados -->
      {relatedProducts.length > 0 && (
        <div class="mt-20">
          <h2 class="text-2xl font-black text-slate-800 mb-8">Productos Relacionados</h2>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            {relatedProducts.map((related: any) => (
              <a href={`/producto/${related.id}`} class="group bg-white rounded-xl border border-slate-200 overflow-hidden hover:shadow-lg transition-all flex flex-col">
                <div class="h-48 overflow-hidden">
                  <img src={related.image} alt={related.name} class="w-full h-full object-cover group-hover:scale-105 transition-transform" />
                </div>
                <div class="p-4 flex-grow">
                  <h3 class="font-bold text-slate-800">{related.name}</h3>
                  <p class="text-sm text-blue-500 font-medium">{related.category}</p>
                </div>
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </div>
</Layout>