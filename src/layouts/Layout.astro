---
import '../styles/global.css';
import { siteData } from '../data/company';
import Header from '../components/Header.astro';

const { title = siteData.title, description = siteData.description } = Astro.props;

// Usamos el logo que subiste para que aparezca al compartir el enlace
const ogImage = "/logo.png";

// Datos que el chatbot necesita, tomados de la MISMA fuente que el footer
// (así nunca vuelven a desincronizarse el horario o el teléfono).
const chatPhone = siteData.contact.phone || "51960457147";
const scheduleText = `${siteData.schedule.days}, de ${siteData.schedule.morning} y de ${siteData.schedule.afternoon}`;
---

<html lang="es">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/png" href="/logo.png" />
        <meta name="viewport" content="width=device-width" />
        
        <!-- SEO Básico -->
        <title>{title}</title>
        <meta name="description" content={description} />
        <meta name="author" content={siteData.name} />
        <meta name="keywords" content="geosinteticos, geomembranas HDPE, geotextiles, geomallas, geoceldas, tuberia HDPE, tuberia PVC, equipos de termofusion, Cajamarca, mineria, agro, infraestructura" />

        <!-- OpenGraph / Facebook / WhatsApp / LinkedIn -->
        <meta property="og:type" content="website" />
        <meta property="og:url" content={Astro.url} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={new URL(ogImage, Astro.url)} />
        <meta property="og:site_name" content={siteData.name} />

        <!-- Twitter -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={new URL(ogImage, Astro.url)} />
    </head>
    <body class="bg-slate-50 text-slate-800 antialiased relative">
        <Header />
        
        <main>
            <slot />
        </main>

        <!-- Asistente Virtual Robot IA - CHATBOT -->
        <div id="ai-chatbot-container" class="fixed bottom-6 left-6 z-50 flex flex-col items-start group font-sans">
          
          <!-- Ventana de Chat (Oculta por defecto) -->
          <div id="ai-chat-window" class="hidden flex-col bg-white w-80 h-[400px] shadow-2xl rounded-2xl border border-slate-200 mb-4 overflow-hidden transform transition-all">
            
            <!-- Header del Chat -->
            <div class="bg-slate-900 text-white p-4 flex items-center justify-between shadow-md z-10">
              <div class="flex items-center gap-3">
                <div class="bg-slate-800 rounded-full p-1 border border-blue-500 relative">
                  <img src="/robot.png" alt="Robot" class="w-8 h-8 object-contain drop-shadow-md" />
                  <span class="absolute bottom-0 right-0 w-2.5 h-2.5 bg-emerald-500 border border-slate-900 rounded-full"></span>
                </div>
                <div>
                  <h4 class="text-sm font-bold text-blue-400">Asistente Globalnorte</h4>
                  <p class="text-[10px] text-slate-300 flex items-center gap-1"><span class="w-1.5 h-1.5 bg-emerald-500 rounded-full animate-pulse"></span> En línea</p>
                </div>
              </div>
              <button id="close-chat" class="text-slate-400 hover:text-white font-bold text-lg cursor-pointer">&times;</button>
            </div>

            <!-- Área de Mensajes -->
            <div id="chat-messages" class="flex-grow p-4 overflow-y-auto bg-slate-50 space-y-3 text-sm flex flex-col">
              <!-- Mensaje de bienvenida -->
              <div class="self-start bg-white border border-slate-200 text-slate-700 p-3 rounded-2xl rounded-tl-sm shadow-sm max-w-[85%]">
                ¡Hola! Soy el asistente virtual de <strong>Globalnorte</strong>. 🧱 <br><br>Puedes preguntarme sobre geosintéticos, tuberías, equipos de termofusión, horarios, ubicación o cómo cotizar. ¿En qué te ayudo hoy?
              </div>
            </div>

            <!-- Input de Texto -->
            <div class="p-3 bg-white border-t border-slate-200">
              <form id="chat-form" class="flex gap-2">
                <input 
                  type="text" 
                  id="chat-input" 
                  class="flex-grow bg-slate-100 border border-slate-200 rounded-full px-4 py-2 text-xs focus:outline-none focus:ring-2 focus:ring-blue-500 text-slate-700"
                  placeholder="Escribe tu consulta aquí..."
                  autocomplete="off"
                />
                <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white rounded-full w-9 h-9 flex items-center justify-center transition-colors cursor-pointer flex-shrink-0">
                  <svg class="w-4 h-4 translate-x-[-1px]" fill="currentColor" viewBox="0 0 20 20"><path d="M10.894 2.553a1 1 0 00-1.788 0l-7 14a1 1 0 001.169 1.409l5-1.429A1 1 0 009 15.571V11a1 1 0 112 0v4.571a1 1 0 00.725.962l5 1.428a1 1 0 001.17-1.408l-7-14z"></path></svg>
                </button>
              </form>
            </div>
          </div>

          <!-- Burbuja de Chat (Hover) -->
          <div id="hover-bubble" class="mb-3 bg-white p-3 rounded-2xl shadow-xl border border-slate-200 opacity-0 group-hover:opacity-100 transition-opacity duration-300 w-56 relative pointer-events-none z-10">
            <p class="text-[11px] text-slate-600 font-medium leading-relaxed">
              ¿Dudas sobre materiales? <strong>¡Haz clic aquí para chatear conmigo!</strong>
            </p>
            <div class="absolute -bottom-2 left-8 w-4 h-4 bg-white transform rotate-45 border-b border-r border-slate-200"></div>
          </div>

          <!-- Botón del Robot -->
          <button 
            id="open-chat"
            class="robot-float relative transition-all duration-300 hover:scale-110 hover:rotate-3 cursor-pointer outline-none bg-transparent border-none p-0"
          >
            <img src="/robot.png" alt="Asistente Virtual" class="w-24 h-24 sm:w-28 sm:h-28 object-contain drop-shadow-[0_15px_15px_rgba(59,130,246,0.3)]" />
            <span class="absolute top-2 right-2 w-4 h-4 bg-emerald-500 border-2 border-white rounded-full z-10 shadow-sm"></span>
            <span class="absolute top-2 right-2 w-4 h-4 bg-emerald-500 rounded-full animate-ping opacity-75 z-0"></span>
            <div class="absolute -bottom-4 left-1/2 transform -translate-x-1/2 w-16 h-4 bg-blue-500/20 blur-xl rounded-full"></div>
          </button>
        </div>

        <!-- Lógica del Chatbot -->
        <script define:vars={{ chatPhone, scheduleText }}>
          const phone = chatPhone; // Viene de siteData, no está hardcodeado

          // Elementos del DOM (Casteados como HTML elements genéricos)
          const chatWindow = document.getElementById('ai-chat-window');
          const openChatBtn = document.getElementById('open-chat');
          const closeChatBtn = document.getElementById('close-chat');
          const hoverBubble = document.getElementById('hover-bubble');
          const chatForm = document.getElementById('chat-form');
          const chatInput = document.getElementById('chat-input');
          const chatMessages = document.getElementById('chat-messages');

          // Abrir Chat (Solo si los elementos existen)
          if (openChatBtn && chatWindow && hoverBubble) {
            openChatBtn.addEventListener('click', () => {
              chatWindow.classList.toggle('hidden');
              chatWindow.classList.toggle('flex');
              hoverBubble.classList.add('hidden'); // Ocultar burbuja inicial
            });
          }

          // Cerrar Chat
          if (closeChatBtn && chatWindow) {
            closeChatBtn.addEventListener('click', () => {
              chatWindow.classList.add('hidden');
              chatWindow.classList.remove('flex');
            });
          }

          // Función para agregar mensajes al chat
          function addMessage(text, sender) {
            if (!chatMessages) return; // Validación de seguridad
            const msgDiv = document.createElement('div');
            msgDiv.className = `p-3 rounded-2xl max-w-[85%] text-sm shadow-sm ${
              sender === 'user' 
                ? 'self-end bg-blue-600 text-white rounded-tr-sm' 
                : 'self-start bg-white border border-slate-200 text-slate-700 rounded-tl-sm'
            }`;
            msgDiv.innerHTML = text;
            chatMessages.appendChild(msgDiv);
            chatMessages.scrollTop = chatMessages.scrollHeight; // Auto-scroll
          }

          // BASE DE CONOCIMIENTOS (alineada al catálogo real: geosintéticos, tuberías, equipos)
          const knowledgeBase = [
            {
              keywords: ["servicios", "que hacen", "a que se dedican", "ofrecen", "productos", "venden"],
              response: "En Globalnorte suministramos <strong>Geosintéticos (geomembranas, geotextiles, geomallas, geoceldas), Tuberías HDPE/PVC y Equipos de Termofusión</strong> para minería, agro, infraestructura y vías. ¿Te interesa algo en específico?"
            },
            {
              keywords: ["geomembrana", "geotextil", "geomalla", "geocelda", "geosintetico", "geosintético"],
              response: "Trabajamos con geomembranas HDPE (lisas y bajo norma GRI-GM13), geotextiles tejidos y no tejidos, geomallas uni/biaxiales y geoceldas. Puedes verlas y armar tu cotización directamente en el <strong>catálogo</strong> de esta página. 📋"
            },
            {
              keywords: ["tuberia", "tubería", "hdpe", "pvc", "agua", "desague", "desagüe"],
              response: "Contamos con tuberías HDPE bajo norma NTP ISO 4427-2 y ASTM F714, y tuberías PVC para agua y desagüe. ¿Buscas para agua potable, riego, minería o saneamiento?"
            },
            {
              keywords: ["termofusion", "termofusión", "electrofusion", "electrofusión", "soldadora", "cuña", "extrusora", "pistola de calor", "equipo"],
              response: "Tenemos máquinas de cuña caliente, pistolas de calor industrial y soldadoras extrusoras para instalar y reparar geomembranas y tuberías en obra. 🔧"
            },
            {
              keywords: ["ubicacion", "donde", "direccion", "cajamarca", "ciudad", "ubican"],
              response: "Nuestra base principal se encuentra en <strong>Cajamarca, Perú</strong>, pero atendemos proyectos y despachamos materiales a diversas obras en la región norte. 📍"
            },
            {
              keywords: ["horario", "hora", "atencion", "abierto", "atienden"],
              response: `Nuestro equipo técnico y comercial atiende ${scheduleText}. ⏰`
            },
            {
              keywords: ["cotizar", "precio", "cuanto cuesta", "presupuesto", "cotizacion", "cotización"],
              response: "Para cotizaciones, agrega los productos que necesitas a tu 'Panel de Cotización' desde el catálogo y envíalos por WhatsApp. Si es un proyecto a medida, te recomiendo hablar directamente con un asesor."
            }
          ];

          // Lógica para procesar el mensaje
          if (chatForm && chatInput && chatMessages) {
            chatForm.addEventListener('submit', (e) => {
              e.preventDefault(); // Previene recarga de web
              const userText = chatInput.value.trim();
              if (!userText) return;

              // 1. Mostrar mensaje del usuario
              addMessage(userText, 'user');
              chatInput.value = '';

              // 2. Simular "Escribiendo..."
              setTimeout(() => {
                const textLower = userText.toLowerCase();
                let botResponse = null;

                // Buscar en la base de conocimientos
                for (const knowledge of knowledgeBase) {
                  if (knowledge.keywords.some(kw => textLower.includes(kw))) {
                    botResponse = knowledge.response;
                    break;
                  }
                }

                // 3. Respuesta si sabe, o derivar a un Humano si no sabe
                if (botResponse) {
                  addMessage(botResponse, 'bot');
                } else {
                  const wsLink = `https://wa.me/${phone}?text=Hola,%20tengo%20esta%20duda:%20${encodeURIComponent(userText)}`;
                  addMessage(`Esa es una excelente pregunta, pero como soy un bot aún estoy aprendiendo sobre ese detalle específico. 🤖<br><br>Te conectaré directamente con uno de nuestros asesores expertos para que te dé una respuesta exacta:<br><br><a href="${wsLink}" target="_blank" class="inline-block mt-2 bg-emerald-500 hover:bg-emerald-600 text-white font-bold py-1.5 px-3 rounded-lg text-xs no-underline transition-colors shadow-md">Hablar con Asesor en WhatsApp</a>`, 'bot');
                }
              }, 600);
            });
          }
        </script>

        <!-- Estilos para la animación de flotar suave -->
        <style>
          @keyframes float {
            0% { transform: translateY(0px); }
            50% { transform: translateY(-12px); }
            100% { transform: translateY(0px); }
          }
          .robot-float { animation: float 4s ease-in-out infinite; }
        </style>
    </body>
</html>